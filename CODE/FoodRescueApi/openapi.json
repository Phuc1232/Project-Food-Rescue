{
  "openapi": "3.0.3",
  "info": {
    "title": "FoodRescue Customer Authentication API",
    "version": "1.0.0",
    "description": "Backend tài khoản khách hàng. OTP 6 số, hiệu lực 10 phút; 5 lần sai/challenge. Access token 15 phút; refresh token tối đa 7 ngày, xoay vòng mỗi lần sử dụng. POST register trả 409 khi email đã dùng. Yêu cầu khôi phục trả cùng cấu trúc kể cả email không đủ điều kiện. Bản phát triển gửi email đến Mailpit."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "operationId": "registerCustomer",
        "summary": "Tạo tài khoản khách hàng chờ xác minh",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "responses": {
          "201": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Register"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/email-verifications": {
      "post": {
        "operationId": "requestEmailVerification",
        "summary": "Yêu cầu mã xác minh email",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Email"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password-reset-requests": {
      "post": {
        "operationId": "requestPasswordReset",
        "summary": "Yêu cầu mã khôi phục; không tiết lộ email có tồn tại",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Email"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/challenges/{id}/verify": {
      "post": {
        "operationId": "verifyChallenge",
        "summary": "Xác minh mã một lần theo mục đích của challenge",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verification"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Verify"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/auth/challenges/{id}/resend": {
      "post": {
        "operationId": "resendChallenge",
        "summary": "Gửi lại sau 60 giây, thay mã cũ",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Đăng nhập tài khoản đã xác minh",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "summary": "Đổi refresh token; dùng lại token cũ thu hồi cả nhóm phiên",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Refresh"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Thu hồi nhóm phiên trên thiết bị hiện tại",
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Thành công, không có nội dung"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/auth/password-resets": {
      "post": {
        "operationId": "resetPassword",
        "summary": "Đổi mật khẩu và thu hồi mọi phiên",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "responses": {
          "204": {
            "description": "Thành công, không có nội dung"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordReset"
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getMyProfile",
        "summary": "Đọc hồ sơ từ danh tính đăng nhập",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "patch": {
        "operationId": "updateMyProfile",
        "summary": "Chỉ cập nhật họ tên và số điện thoại",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdate"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Register": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "writeOnly": true
          }
        }
      },
      "Login": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          }
        }
      },
      "Email": {
        "type": "object",
        "required": [
          "email"
        ],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        }
      },
      "Verify": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "writeOnly": true
          }
        }
      },
      "Refresh": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "additionalProperties": false,
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 128,
            "writeOnly": true
          }
        }
      },
      "PasswordReset": {
        "type": "object",
        "required": [
          "resetGrant",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "resetGrant": {
            "type": "string",
            "maxLength": 128,
            "writeOnly": true
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "writeOnly": true
          }
        }
      },
      "ProfileUpdate": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "pattern": "^$|^(0[0-9]{9}|\\+84[0-9]{9})$"
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "KHACH_HANG",
              "CHU_CUA_HANG",
              "NHAN_VIEN",
              "QUAN_TRI_VIEN"
            ]
          }
        }
      },
      "Challenge": {
        "type": "object",
        "required": [
          "id",
          "email",
          "purpose",
          "expiresInSeconds",
          "resendInSeconds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "purpose": {
            "type": "string",
            "enum": [
              "VERIFY_EMAIL",
              "RESET_PASSWORD"
            ]
          },
          "expiresInSeconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 600
          },
          "resendInSeconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 60
          }
        }
      },
      "Verification": {
        "type": "object",
        "required": [
          "verified",
          "resetGrant"
        ],
        "additionalProperties": false,
        "properties": {
          "verified": {
            "type": "boolean"
          },
          "resetGrant": {
            "type": "string",
            "nullable": true,
            "description": "Chỉ trả khi xác minh RESET_PASSWORD; một lần, hết hạn sau 10 phút."
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "accessToken",
          "refreshToken",
          "expiresInSeconds",
          "tokenType",
          "user"
        ],
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresInSeconds": {
            "type": "integer",
            "format": "int64",
            "example": 900
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "user": {
            "$ref": "#/components/schemas/Profile"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "fieldErrors",
          "traceId"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "400 dữ liệu/mã sai; 401 phiên hoặc thông tin đăng nhập; 403 chưa xác minh/không có quyền; 409 email trùng; 410 mã/quyền đã hết hạn hoặc đã dùng; 429 vượt giới hạn; 503 dịch vụ/email chưa sẵn sàng.",
        "headers": {
          "Retry-After": {
            "description": "Số giây nên chờ nếu có giới hạn tần suất.",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
