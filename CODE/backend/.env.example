# Copy this file to .env in the backend project root. Spring Boot loads it as properties.
DB_URL=jdbc:postgresql://localhost:5432/foodrescue_db
DB_USER=foodrescue
DB_PASSWORD=replace-with-local-password
JWT_PRIVATE_KEY_LOCATION=file:C:/path/outside-repo/private.pem
JWT_PUBLIC_KEY_LOCATION=file:C:/path/outside-repo/public.pem
JWT_KEY_ID=local-2026-01
JWT_ISSUER=foodrescue
JWT_AUDIENCE=foodrescue-api
JWT_ACCESS_TTL=15m
AUTH_SESSION_TTL=7d
AUTH_RESET_TTL=15m
AUTH_VERIFY_TTL=24h
RATE_LIMIT_KEY_SECRET=replace-with-random-secret-at-least-32-bytes
TRUSTED_PROXY_CIDRS=
CORS_ORIGINS=http://localhost:3000
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@foodrescue.local
MAIL_STARTTLS=false
AUTH_ACTION_BASE_URL=http://localhost:3000
