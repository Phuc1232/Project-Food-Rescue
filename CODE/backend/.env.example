# Copy this file to .env in the backend project root. Spring Boot loads it as properties.
DB_URL=jdbc:postgresql://localhost:5432/foodrescue_db
DB_USER=foodrescue
DB_PASSWORD=replace-with-local-password
JWT_PRIVATE_KEY_LOCATION=file:C:/path/outside-repo/private.pem
JWT_PUBLIC_KEY_LOCATION=file:C:/path/outside-repo/public.pem
JWT_KEY_ID=local-2026-01
JWT_ISSUER=foodrescue
JWT_AUDIENCE=foodrescue-api
JWT_ACCESS_TTL=15m
AUTH_SESSION_TTL=7d
AUTH_RESET_TTL=15m
AUTH_VERIFY_TTL=24h
RATE_LIMIT_KEY_SECRET=replace-with-random-secret-at-least-32-bytes
TRUSTED_PROXY_CIDRS=
CORS_ORIGINS=http://localhost:3000
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@foodrescue.local
MAIL_STARTTLS=false
AUTH_ACTION_BASE_URL=http://localhost:3000
# File uploads (T3.1). Omit FILE_STORAGE_DIR locally to use ~/.foodrescue/files (an empty value is invalid);
# required in production, e.g. a mounted volume outside the repo.
# FILE_STORAGE_DIR=/absolute/path/outside-repo/files
FILE_MAX_SIZE=10MB
FILE_MAX_REQUEST_SIZE=12MB
# Payments (T6.1). PAYMENT_GATEWAY=fake for local work without real money; payos needs the three keys of your payOS
# payment channel (Kênh thanh toán). Never commit real values.
PAYMENT_GATEWAY=fake
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/payment/return
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
# Pickup credentials (T7.1), required in every environment. Keys are 32 random bytes encoded as Base64.
# PICKUP_CODE_KEYS format: v1:<base64-key>,v2:<base64-key>; retain old keys when activating a new key.
PICKUP_CODE_ACTIVE_KEY_ID=
PICKUP_CODE_KEYS=

# T8.4: independent AES-256 key ring (id:base64_32bytes,...)
PAYOUT_ACCOUNT_ACTIVE_KEY_ID=
PAYOUT_ACCOUNT_KEYS=
