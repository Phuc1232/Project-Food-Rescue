POSTGRES_DB=foodrescue
POSTGRES_USER=foodrescue
POSTGRES_PASSWORD=foodrescue_local_only
POSTGRES_PORT=5432
API_PORT=8080
# Generate TWO independent values; see FoodRescueApi/README.md. Do not commit .env.
AUTH_SIGNING_KEY=
AUTH_CHALLENGE_KEY=
# Local mailbox defaults below. For real Gmail OTP, from CODE run:
# pwsh -STA -File ./FoodRescueApi/SetupEmail.ps1 -Provider Gmail
# The form configures smtp.gmail.com:587 with STARTTLS. Credentials stay in .env.
MAIL_HOST=mailpit
MAIL_MODE=sandbox
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_SSL=false
MAIL_TEST_CONNECTION=false
MAIL_FROM=no-reply@foodrescue.test
COMPOSE_PROFILES=mail-preview
MAIL_UI_PORT=8025
MAIL_SMTP_PORT=1025
